# ─────────────────────────────────────────────────────────────
# CustomerIQ — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# PostgreSQL / Supabase connection string
# Local dev alternative: sqlite:///./customeriq.db
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project (required for real JWT auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend API base URL (change if deploying remotely)
API_BASE_URL=http://localhost:8000

# Redis (caching + Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Logging / runtime
LOG_JSON=false
DEBUG=false

# ── SECURITY: demo-token bypass ─────────────────────────────
# Enables the hard-coded "dummy-token" auth bypass used by the
# offline local-dev flows. MUST stay false in any production build.
ALLOW_DEMO_TOKEN=false

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8501

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
